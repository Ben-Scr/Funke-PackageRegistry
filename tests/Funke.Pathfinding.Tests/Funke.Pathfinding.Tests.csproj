<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FunkeEngineRoot Condition="'$(FunkeEngineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Index</FunkeEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../packages/Funke.Pathfinding/Source/**/*.cs" />
    <Compile Include="../../packages/Funke.Pathfinding3D/Source/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../packages/Funke.Pathfinding3D/Examples/**/*.cs" />
    <Reference Include="Funke-ScriptCore">
      <HintPath>$(FunkeEngineRoot)/bin/Release-windows-x86_64/Funke-ScriptCore/Funke-ScriptCore.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
