<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FunkeEngineRoot Condition="'$(FunkeEngineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Index</FunkeEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Funke.Pathfinding.Tests/Program.cs" />
    <Compile Include="../../packages/Funke.Pathfinding3D/Examples/**/*.cs" />
    <Reference Include="Pkg.Funke.Pathfinding"><HintPath>$(PathfindingPackageBin)/Pkg.Funke.Pathfinding/Pkg.Funke.Pathfinding.dll</HintPath></Reference>
    <Reference Include="Pkg.Funke.Pathfinding3D"><HintPath>$(PathfindingPackageBin)/Pkg.Funke.Pathfinding3D/Pkg.Funke.Pathfinding3D.dll</HintPath></Reference>
    <Reference Include="Funke-ScriptCore"><HintPath>$(FunkeEngineRoot)/bin/Release-windows-x86_64/Funke-ScriptCore/Funke-ScriptCore.dll</HintPath></Reference>
  </ItemGroup>
</Project>
